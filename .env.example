# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Required: DeepSeek API key used as the agent's LLM (https://platform.deepseek.com)
deepseek_api_key=

# Optional but recommended: LangSmith tracing, so every LLM/tool call in a run is inspectable.
# If LANGSMITH_TRACING is not "true", tracing is simply skipped (no error).
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentsimulator-orchestrator

# Optional: override the server bind host/port (defaults to 127.0.0.1:8000 — localhost only,
# since this agent has subprocess + filesystem tool access and must not be exposed casually).
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=8000

# Optional: safety caps (defaults shown)
ORCHESTRATOR_MAX_NUM_SIMULATIONS=20
ORCHESTRATOR_MAX_CONCURRENT_JOBS=1
ORCHESTRATOR_SIMULATION_TIMEOUT_SECONDS=7200
