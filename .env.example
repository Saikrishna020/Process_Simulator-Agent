# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
#
# Process Lab needs NO credentials: the engine, Scenario builder, Results, Experiment history
# and all ten Data Analyst preset questions work without any key. A key is required only for
# the Simulation assistant tab and free-text analyst questions.

# Optional: DeepSeek API key for the assistant (https://platform.deepseek.com)
deepseek_api_key=

# Optional: LangSmith tracing, so every LLM/tool call in an assistant run is inspectable.
# If LANGSMITH_TRACING is not "true", tracing is simply skipped (no error).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=processlab

# Optional: server bind host/port. Defaults to 127.0.0.1:8000 — localhost only, since the
# assistant has filesystem access and there is no authentication.
HOST=127.0.0.1
PORT=8000

# Optional: safety caps (defaults shown)
MAX_CONCURRENT_JOBS=1
EXPERIMENT_TIMEOUT_SECONDS=900
MAX_CLARIFICATION_TURNS=5
